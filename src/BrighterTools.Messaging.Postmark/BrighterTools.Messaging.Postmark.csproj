<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>Opt-out automatic retries and explicit Postmark rejection classification for hosts with durable queues; default retry behaviour retained.</PackageReleaseNotes>
    <PackageId>BrighterTools.Messaging.Postmark</PackageId>
    <Title>BrighterTools.Messaging.Postmark</Title>
    <RootNamespace>BrighterTools.Messaging.Postmark</RootNamespace>
    <Description>Postmark email transport for BrighterTools.Messaging.</Description>
    <PackageTags>messaging;email;postmark</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BrighterTools.Messaging" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="Postmark" Version="5.4.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404" PrivateAssets="all" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
