<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>BrighterTools.Messaging.SendGrid</PackageId>
    <Title>BrighterTools.Messaging.SendGrid</Title>
    <RootNamespace>BrighterTools.Messaging.SendGrid</RootNamespace>
    <Description>SendGrid email transport for BrighterTools.Messaging.</Description>
    <PackageTags>messaging;email;sendgrid</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrighterTools.Messaging\BrighterTools.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="SendGrid" Version="9.29.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>