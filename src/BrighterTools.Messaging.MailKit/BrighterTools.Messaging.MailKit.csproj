<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>BrighterTools.Messaging.MailKit</PackageId>
    <Title>BrighterTools.Messaging.MailKit</Title>
    <RootNamespace>BrighterTools.Messaging.MailKit</RootNamespace>
    <Description>MailKit SMTP transport for BrighterTools.Messaging.</Description>
    <PackageTags>messaging;email;smtp;mailkit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrighterTools.Messaging\BrighterTools.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.15.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <PackageReference Include="Polly" Version="8.6.6" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
